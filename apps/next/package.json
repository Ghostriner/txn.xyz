from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
from cryptography.hazmat.primitives.hashes import SHA256
from cryptography.hazmat.backends import default_backend
import base64
import os

def decipher_wallet_phrase(phrase, passphrase=""):
    """
    Deciphers a wallet phrase using PBKDF2 key derivation.

    Parameters:
        phrase (str): The mnemonic phrase (seed phrase).
        passphrase (str): An optional passphrase for added security.

    Returns:
        str: Deciphered key or derived key.
    """
    # Convert phrase to bytes
    phrase_bytes = phrase.encode('utf-8')
    passphrase_bytes = passphrase.encode('utf-8')

    # Generate a salt (this should be securely generated and stored)
    salt = os.urandom(16)

    # Key derivation function (PBKDF2)
    kdf = PBKDF2HMAC(
        algorithm=SHA256(),
        length=32,
        salt=salt,
        iterations=100000,
        backend=default_backend()
    )

    # Derive key
    derived_key = kdf.derive(phrase_bytes + passphrase_bytes)

    # Encode key for storage or display
    encoded_key = base64.urlsafe_b64encode(derived_key).decode('utf-8')

    return encoded_key

# Example usage
wallet_phrase = "word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
passphrase = "optional-passphrase"
derived_key = decipher_wallet_phrase(wallet_phrase, passphrase)
print("Derived Key:", derived_key)
